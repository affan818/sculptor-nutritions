<section class="best-sellers">

  <div class="page-width">

    <!-- HEADER -->

    <div class="best-sellers__header">

      <h2>
        {{ section.settings.heading }}
      </h2>

      {% if section.settings.view_all_link != blank %}
        <a href="{{ section.settings.view_all_link }}">
          View all
        </a>
      {% endif %}

    </div>

    <!-- PRODUCTS -->

    <div class="best-sellers__grid">

      {% for product in section.settings.collection.products limit: 5 %}

        <div class="best-product-card">

          <!-- IMAGE -->

          <a
            href="{{ product.url }}"
            class="best-product-card__image"
          >

            {% if product.featured_image != blank %}

              {{
                product.featured_image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  alt: product.title
              }}

            {% endif %}

          </a>

          <!-- CONTENT -->

          <div class="best-product-card__content">

            <h3>
              <a href="{{ product.url }}">
                {{ product.title }}
              </a>
            </h3>

            <!-- RATING -->

            <div class="best-product-card__rating">

              ★★★★★

            </div>

            <!-- PRICE -->

            <div class="best-product-card__price">

              {% if product.compare_at_price > product.price %}

                <span class="compare-price">
                  {{ product.compare_at_price | money }}
                </span>

              {% endif %}

              <span class="sale-price">
                {{ product.price | money }}
              </span>

            </div>

            <!-- BUTTON -->

            <form
              method="post"
              action="/cart/add"
            >

              <input
                type="hidden"
                name="id"
                value="{{ product.selected_or_first_available_variant.id }}"
              >

              <button type="submit">

                ADD TO CART

              </button>

            </form>

          </div>

        </div>

      {% endfor %}

    </div>

  </div>

</section>

{% schema %}
{
  "name": "Best Sellers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers"
    }
  ]
}
{% endschema %}