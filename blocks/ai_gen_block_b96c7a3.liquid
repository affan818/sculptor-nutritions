          <div class="ai-contact-info-card-{{ ai_gen_id }}">
            <div class="ai-contact-info-icon-{{ ai_gen_id }}">
              {%- if block.settings.info_3_icon_image != blank -%}
                <img
                  src="{{ block.settings.info_3_icon_image | image_url: width: 100 }}"
                  alt="{{ block.settings.info_3_title }}"
                  loading="lazy"
