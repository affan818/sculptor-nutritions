{% doc %}
  @prompt
    Create a premium fully responsive Shopify Contact Us section for a supplement brand website.
    
    Design:
    - Modern split layout
    - Left side contact form
    - Right side contact information cards
    - Clean light background
    - Premium minimal supplement brand aesthetic
    - Rounded corners, soft borders, subtle shadows
    
    Left Side:
    - Heading: “Send Us a Message”
    - Name field
    - Email field
    - Subject field
    - Message textarea
    - Premium CTA button
    - Small trust/safety note below button
    
    Right Side:
    - Contact information blocks with selectable/uploadable icons
    - Examples:
      - Customer Support
      - Orders & Returns
      - Office Address
      - Business Hours
    
    Shopify Customization:
    - Edit all text
    - Add/remove/reorder contact info blocks
    - Change icons
    - Change button text
    - Change colors and spacing
    - Enable/disable fields
    - Fully editable form labels/placeholders
    
    Technical:
    - Shopify Liquid
    - Shopify contact form functionality
    - Dawn theme compatible
    - Fully responsive
    - No horizontal scroll
    - Optimized performance
    - Reusable Shopify section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_background }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-contact-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-contact-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.grid_gap }}px;
    align-items: start;
  }

  .ai-contact-form-wrapper-{{ ai_gen_id }} {
    background-color: {{ block.settings.form_background }};
    padding: {{ block.settings.form_padding }}px;
    border-radius: {{ block.settings.card_border_radius }}px;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    box-shadow: 0 {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
  }

  .ai-contact-form-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-weight: 600;
    line-height: 1.2;
  }

  .ai-contact-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.field_spacing }}px;
  }

  .ai-contact-field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-contact-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    font-weight: 500;
  }

  .ai-contact-input-{{ ai_gen_id }},
  .ai-contact-textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.input_padding }}px;
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: {{ block.settings.input_text_size }}px;
    color: {{ block.settings.input_text_color }};
    background-color: {{ block.settings.input_background }};
    transition: border-color 0.3s ease;
  }

  .ai-contact-input-{{ ai_gen_id }}::placeholder,
  .ai-contact-textarea-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.placeholder_color }};
  }

  .ai-contact-input-{{ ai_gen_id }}:focus,
  .ai-contact-textarea-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_border }};
  }

  .ai-contact-textarea-{{ ai_gen_id }} {
    min-height: {{ block.settings.textarea_height }}px;
    resize: vertical;
    font-family: inherit;
  }

  .ai-contact-button-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.button_padding }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .ai-contact-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-contact-trust-note-{{ ai_gen_id }} {
    margin-top: {{ block.settings.field_spacing }}px;
    font-size: {{ block.settings.trust_note_size }}px;
    color: {{ block.settings.trust_note_color }};
    text-align: center;
    line-height: 1.5;
  }

  .ai-contact-success-{{ ai_gen_id }} {
    padding: 16px;
    background-color: #d4edda;
    color: #155724;
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-bottom: {{ block.settings.field_spacing }}px;
    text-align: center;
  }

  .ai-contact-error-{{ ai_gen_id }} {
    padding: 16px;
    background-color: #f8d7da;
    color: #721c24;
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-bottom: {{ block.settings.field_spacing }}px;
  }

  .ai-contact-info-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.info_card_gap }}px;
  }

  .ai-contact-info-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.info_card_background }};
    padding: {{ block.settings.info_card_padding }}px;
    border-radius: {{ block.settings.card_border_radius }}px;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    box-shadow: 0 {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
    display: flex;
    gap: {{ block.settings.info_card_icon_gap }}px;
    align-items: flex-start;
  }

  .ai-contact-info-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_background }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    color: {{ block.settings.icon_color }};
  }

  .ai-contact-info-icon-{{ ai_gen_id }} img {
    width: {{ block.settings.icon_image_size }}px;
    height: {{ block.settings.icon_image_size }}px;
    object-fit: contain;
  }

  .ai-contact-info-icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_image_size }}px;
    height: {{ block.settings.icon_image_size }}px;
  }

  .ai-contact-info-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-contact-info-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.info_title_size }}px;
    color: {{ block.settings.info_title_color }};
    font-weight: 600;
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .ai-contact-info-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.info_text_size }}px;
    color: {{ block.settings.info_text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-contact-info-text-{{ ai_gen_id }} a {
    color: {{ block.settings.info_link_color }};
    text-decoration: none;
  }

  .ai-contact-info-text-{{ ai_gen_id }} a:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 989px) {
    .ai-contact-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-contact-form-wrapper-{{ ai_gen_id }},
    .ai-contact-info-card-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding }}px;
    }

    .ai-contact-form-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.85 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-contact-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 0 {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-contact-info-card-{{ ai_gen_id }} {
      flex-direction: row;
    }
  }
{% endstyle %}

<contact-section-{{ ai_gen_id }} class="ai-contact-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-container-{{ ai_gen_id }}">
    <div class="ai-contact-grid-{{ ai_gen_id }}">
      <div class="ai-contact-form-wrapper-{{ ai_gen_id }}">
        <h2 class="ai-contact-form-heading-{{ ai_gen_id }}">{{ block.settings.form_heading }}</h2>
        
        {%- form 'contact' -%}
          <div class="ai-contact-form-{{ ai_gen_id }}">
            {%- if form.posted_successfully? -%}
              <div class="ai-contact-success-{{ ai_gen_id }}">
                {{ block.settings.success_message }}
              </div>
            {%- endif -%}

            {%- if form.errors -%}
              <div class="ai-contact-error-{{ ai_gen_id }}">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            {%- if block.settings.show_name_field -%}
              <div class="ai-contact-field-{{ ai_gen_id }}">
                <label class="ai-contact-label-{{ ai_gen_id }}" for="contact-name-{{ ai_gen_id }}">
                  {{ block.settings.name_label }}
                </label>
                <input
                  type="text"
                  id="contact-name-{{ ai_gen_id }}"
                  name="contact[name]"
                  class="ai-contact-input-{{ ai_gen_id }}"
                  placeholder="{{ block.settings.name_placeholder }}"
                  {% if block.settings.name_required %}required{% endif %}
                >
              </div>
            {%- endif -%}

            <div class="ai-contact-field-{{ ai_gen_id }}">
              <label class="ai-contact-label-{{ ai_gen_id }}" for="contact-email-{{ ai_gen_id }}">
                {{ block.settings.email_label }}
              </label>
              <input
                type="email"
                id="contact-email-{{ ai_gen_id }}"
                name="contact[email]"
                class="ai-contact-input-{{ ai_gen_id }}"
                placeholder="{{ block.settings.email_placeholder }}"
                autocomplete="email"
                required
              >
            </div>

            {%- if block.settings.show_subject_field -%}
              <div class="ai-contact-field-{{ ai_gen_id }}">
                <label class="ai-contact-label-{{ ai_gen_id }}" for="contact-subject-{{ ai_gen_id }}">
                  {{ block.settings.subject_label }}
                </label>
                <input
                  type="text"
                  id="contact-subject-{{ ai_gen_id }}"
                  name="contact[subject]"
                  class="ai-contact-input-{{ ai_gen_id }}"
                  placeholder="{{ block.settings.subject_placeholder }}"
                  {% if block.settings.subject_required %}required{% endif %}
                >
              </div>
            {%- endif -%}

            <div class="ai-contact-field-{{ ai_gen_id }}">
              <label class="ai-contact-label-{{ ai_gen_id }}" for="contact-message-{{ ai_gen_id }}">
                {{ block.settings.message_label }}
              </label>
              <textarea
                id="contact-message-{{ ai_gen_id }}"
                name="contact[body]"
                class="ai-contact-textarea-{{ ai_gen_id }}"
                placeholder="{{ block.settings.message_placeholder }}"
                required
              ></textarea>
            </div>

            <button type="submit" class="ai-contact-button-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </button>

            {%- if block.settings.trust_note != blank -%}
              <div class="ai-contact-trust-note-{{ ai_gen_id }}">
                {{ block.settings.trust_note }}
              </div>
            {%- endif -%}
          </div>
        {%- endform -%}
      </div>

      <div class="ai-contact-info-wrapper-{{ ai_gen_id }}">
        {%- if block.settings.show_info_1 -%}
          <div class="ai-contact-info-card-{{ ai_gen_id }}">
            <div class="ai-contact-info-icon-{{ ai_gen_id }}">
              {%- if block.settings.info_1_icon_image != blank -%}
                <img
                  src="{{ block.settings.info_1_icon_image | image_url: width: 100 }}"
                  alt="{{ block.settings.info_1_title }}"
                  loading="lazy"
                  width="100"
                  height="100"
                >
              {%- else -%}
                {%- case block.settings.info_1_icon_type -%}
                  {%- when 'support' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                  {%- when 'orders' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                  {%- when 'location' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  {%- when 'clock' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  {%- when 'email' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  {%- when 'phone' -%}
