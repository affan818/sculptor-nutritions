{% doc %}
  @prompt
    generate a good looking footer with proper logo placement and manual fetch footer link by dashboard and payment partner icons add option on bottom also copyrigt reserved text placement , the bottom line should be customizable by color , the payments icons should look bright and visible 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    width: 100%;
  }

  .ai-footer-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-footer-main-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-footer-logo-section-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-footer-logo-{{ ai_gen_id }} {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-footer-logo-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-footer-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    opacity: 0.9;
  }

  .ai-footer-links-section-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-footer-links-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_font_size }}px;
    font-weight: 600;
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-footer-links-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-footer-link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-size: {{ block.settings.link_font_size }}px;
    transition: color 0.3s ease;
  }

  .ai-footer-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-footer-bottom-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 30px;
    gap: 20px;
    flex-wrap: wrap;
    background-color: {{ block.settings.bottom_background_color }};
    margin: 0 -20px;
    padding-left: 20px;
    padding-right: 20px;
    padding-bottom: {{ block.settings.bottom_padding_bottom }}px;
  }

  .ai-footer-copyright-{{ ai_gen_id }} {
    font-size: {{ block.settings.copyright_font_size }}px;
    color: {{ block.settings.bottom_text_color }};
    opacity: 0.8;
  }

  .ai-footer-payment-icons-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .ai-footer-payment-icon-{{ ai_gen_id }} {
    width: {{ block.settings.payment_icon_size }}px;
    height: auto;
    opacity: 1;
    transition: transform 0.3s ease;
    background-color: {{ block.settings.payment_icon_background }};
    padding: 6px;
    border-radius: 4px;
  }

  .ai-footer-payment-icon-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
  }

  .ai-footer-payment-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: auto;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-footer-main-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-footer-bottom-{{ ai_gen_id }} {
      flex-direction: column;
      text-align: center;
      gap: 20px;
    }

    .ai-footer-payment-icons-{{ ai_gen_id }} {
      justify-content: center;
    }
  }
{% endstyle %}

<footer-block-{{ ai_gen_id }} class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-container-{{ ai_gen_id }}">
    <div class="ai-footer-main-{{ ai_gen_id }}">
      <div class="ai-footer-logo-section-{{ ai_gen_id }}">
        {% if block.settings.logo %}
          <div class="ai-footer-logo-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.logo | image_url: width: 400 }}"
              alt="{{ shop.name }}"
              loading="lazy"
              width="{{ block.settings.logo.width }}"
              height="{{ block.settings.logo.height }}"
            >
          </div>
        {% else %}
          <div class="ai-footer-logo-{{ ai_gen_id }}">
            <h2 style="margin: 0; font-size: 24px;">{{ shop.name }}</h2>
          </div>
        {% endif %}

        {% if block.settings.description != blank %}
