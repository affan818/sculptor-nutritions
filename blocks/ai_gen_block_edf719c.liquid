      {% endif %}

      {% if product.has_only_default_variant == false %}
        {% for option in product.options_with_values %}
          <div class="ai-premium-product-variants-{{ ai_gen_id }}">
            <label class="ai-premium-product-variant-label-{{ ai_gen_id }}">{{ option.name }}</label>
            <div class="ai-premium-product-variant-options-{{ ai_gen_id }}">
              {% for value in option.values %}
                <button 
                  type="button"
                  class="ai-premium-product-variant-button-{{ ai_gen_id }} {% if option.selected_value == value %}active{% endif %}"
                  data-option-position="{{ option.position }}"
                  data-option-value="{{ value | escape }}"
                  data-option-name="{{ option.name | escape }}"
                >
                  {{ value }}
