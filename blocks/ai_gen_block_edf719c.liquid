            type="number" 
            class="ai-premium-product-quantity-input-{{ ai_gen_id }}" 
            value="1" 
            min="1"
            aria-label="Quantity"
          >
          <button type="button" class="ai-premium-product-quantity-button-{{ ai_gen_id }}" data-action="increase">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </button>
        </div>
      </div>

      <button type="button" class="ai-premium-product-add-to-cart-{{ ai_gen_id }}">
        ADD TO CART
      </button>

      {% if block.settings.show_buy_now %}
        <button type="button" class="ai-premium-product-buy-now-{{ ai_gen_id }}">
          BUY IT NOW
        </button>
      {% endif %}
    </div>
  </div>

  <script type="application/json" data-product-json>
    {{ product | json }}
  </script>
</premium-product-{{ ai_gen_id }}>

<script>
  (function() {
    class PremiumProduct{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentVariant = null;
        this.productData = null;
      }

      connectedCallback() {
        const productJson = this.querySelector('[data-product-json]');
        if (productJson) {
          this.productData = JSON.parse(productJson.textContent);
        }

        this.thumbnails = this.querySelectorAll('.ai-premium-product-thumbnail-{{ ai_gen_id }}');
        this.mainImage = this.querySelector('.ai-premium-product-main-image-{{ ai_gen_id }}');
        this.variantButtons = this.querySelectorAll('.ai-premium-product-variant-button-{{ ai_gen_id }}');
        this.quantityInput = this.querySelector('.ai-premium-product-quantity-input-{{ ai_gen_id }}');
        this.quantityButtons = this.querySelectorAll('.ai-premium-product-quantity-button-{{ ai_gen_id }}');
        this.addToCartButton = this.querySelector('.ai-premium-product-add-to-cart-{{ ai_gen_id }}');
        this.buyNowButton = this.querySelector('.ai-premium-product-buy-now-{{ ai_gen_id }}');
        this.priceDisplay = this.querySelector('[data-price-display]');

        this.setupThumbnails();
        this.setupVariants();
        this.setupQuantity();
        this.setupAddToCart();
        
        if (this.productData && this.productData.variants) {
          this.currentVariant = this.productData.variants[0];
        }
      }

      setupThumbnails() {
        this.thumbnails.forEach((thumbnail, index) => {
          thumbnail.addEventListener('click', () => {
            this.thumbnails.forEach(t => t.classList.remove('active'));
            thumbnail.classList.add('active');
            
            const imageSrc = thumbnail.dataset.imageSrc;
            if (imageSrc && this.mainImage) {
              this.mainImage.src = imageSrc;
            }
          });
        });
      }

      setupVariants() {
        this.variantButtons.forEach(button => {
          button.addEventListener('click', () => {
            const position = button.dataset.optionPosition;
            const optionName = button.dataset.optionName;
            const siblings = this.querySelectorAll(`[data-option-position="${position}"]`);
            
            siblings.forEach(sibling => sibling.classList.remove('active'));
            button.classList.add('active');

            this.updateVariant();
            
            if (optionName && (optionName.toLowerCase().includes('flavor') || optionName.toLowerCase().includes('flavour'))) {
              this.updateImageByFlavor(button.dataset.optionValue);
            }
          });
        });
      }

      updateVariant() {
        if (!this.productData || !this.productData.variants) return;

        const selectedOptions = {};
        this.variantButtons.forEach(button => {
          if (button.classList.contains('active')) {
            const position = parseInt(button.dataset.optionPosition);
            selectedOptions[`option${position}`] = button.dataset.optionValue;
          }
        });

        const matchingVariant = this.productData.variants.find(variant => {
          return Object.keys(selectedOptions).every(key => {
            return variant[key] === selectedOptions[key];
          });
        });

        if (matchingVariant) {
          this.currentVariant = matchingVariant;
          this.updatePrice(matchingVariant.price);
          
          if (matchingVariant.featured_image && matchingVariant.featured_image.src) {
            this.updateMainImage(matchingVariant.featured_image.src, matchingVariant.featured_image.id);
          }
        }
      }

      updatePrice(price) {
        if (this.priceDisplay) {
          const formattedPrice = new Intl.NumberFormat('en-IN', {
            style: 'currency',
            currency: 'INR'
          }).format(price / 100);
          this.priceDisplay.textContent = formattedPrice;
        }
      }

      updateImageByFlavor(flavorValue) {
        if (!this.productData || !this.productData.images) return;

        const flavorImage = this.productData.images.find(image => {
          if (image.alt) {
            return image.alt.toLowerCase().includes(flavorValue.toLowerCase());
          }
          return false;
        });

        if (flavorImage && flavorImage.src) {
          this.updateMainImage(flavorImage.src, flavorImage.id);
        }
      }

      updateMainImage(imageSrc, imageId) {
        if (this.mainImage) {
          this.mainImage.src = imageSrc;
          
          this.thumbnails.forEach(thumb => {
            const thumbImageId = thumb.dataset.imageId;
            if (thumbImageId && thumbImageId === String(imageId)) {
              this.thumbnails.forEach(t => t.classList.remove('active'));
              thumb.classList.add('active');
            }
          });
        }
      }

      setupQuantity() {
        this.quantityButtons.forEach(button => {
          button.addEventListener('click', () => {
            const action = button.dataset.action;
            let currentValue = parseInt(this.quantityInput.value) || 1;

            if (action === 'increase') {
              this.quantityInput.value = currentValue + 1;
            } else if (action === 'decrease' && currentValue > 1) {
              this.quantityInput.value = currentValue - 1;
            }
          });
        });

        this.quantityInput.addEventListener('change', () => {
          const value = parseInt(this.quantityInput.value) || 1;
          this.quantityInput.value = Math.max(1, value);
        });
      }

      setupAddToCart() {
        if (this.addToCartButton) {
          this.addToCartButton.addEventListener('click', () => {
            const quantity = parseInt(this.quantityInput.value) || 1;
            const variantId = this.currentVariant ? this.currentVariant.id : null;
            
            if (variantId) {
              this.addToCart(variantId, quantity);
            }
          });
        }

        if (this.buyNowButton) {
          this.buyNowButton.addEventListener('click', () => {
            const quantity = parseInt(this.quantityInput.value) || 1;
            const variantId = this.currentVariant ? this.currentVariant.id : null;
            
            if (variantId) {
              this.buyNow(variantId, quantity);
            }
          });
        }
      }

      addToCart(variantId, quantity) {
        this.addToCartButton.disabled = true;
        this.addToCartButton.textContent = 'ADDING...';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: variantId,
            quantity: quantity
          })
        })
        .then(response => response.json())
        .then(data => {
          window.location.href = '/cart';
        })
        .catch(error => {
          console.error('Error:', error);
          this.addToCartButton.disabled = false;
          this.addToCartButton.textContent = 'ADD TO CART';
          alert('Failed to add to cart. Please try again.');
        });
      }

      buyNow(variantId, quantity) {
        this.buyNowButton.disabled = true;
        this.buyNowButton.textContent = 'PROCESSING...';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: variantId,
            quantity: quantity
          })
        })
        .then(response => response.json())
        .then(data => {
          window.location.href = '/checkout';
        })
        .catch(error => {
          console.error('Error:', error);
          this.buyNowButton.disabled = false;
          this.buyNowButton.textContent = 'BUY IT NOW';
          alert('Failed to process. Please try again.');
        });
      }
    }

    customElements.define('premium-product-{{ ai_gen_id }}', PremiumProduct{{ ai_gen_id }});
  })();
</script>

